# Environment variables for PlanVenture Account Service
# This is a template - do not commit with real credentials

# Database configuration for SQL Server
DATABASE_URL=mssql+pyodbc://sa:YourStrong@Passw0rd@localhost:1433/planventure?driver=ODBC+Driver+17+for+SQL+Server

# Individual database connection parameters
# These are used by utility scripts like init_db.py and migrate_to_mssql.py
DB_SERVER=localhost,1433
DB_USERNAME=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_NAME=planventure
DB_DRIVER=ODBC Driver 17 for SQL Server

# JWT configuration
SECRET_KEY=your-secret-key-at-least-32-bytes-long
JWT_SECRET_KEY=your-jwt-secret-key-at-least-32-bytes-long

# Email configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@planventure.com

# Application configuration
FLASK_APP=app.py
FLASK_ENV=development

# Email verification configuration
# Comma-separated list of allowed email domains for registration
ALLOWED_EMAIL_DOMAINS="company.com,another-domain.org"
# Duration in hours for how long email verification tokens are valid
EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=24

# Initial Admin User (for bootstrap script)
# Email for the initial admin user created by the bootstrap script
INITIAL_ADMIN_EMAIL="admin@company.com"
# Password for the initial admin user
INITIAL_ADMIN_PASSWORD="SecureAdminPassword123!"

# Frontend URL (Ensure this points to where your frontend is running)
# Used for generating correct links in emails (e.g., verification, password reset)
FRONTEND_URL="http://localhost:5173"
