# Environment variables for PlanVenture Account Service
# This is a template - do not commit with real credentials

# Database configuration for SQL Server
DATABASE_URL=mssql+pyodbc://sa:YourStrong@Passw0rd@localhost:1433/planventure?driver=ODBC+Driver+17+for+SQL+Server

# Individual database connection parameters
# These are used by utility scripts like init_db.py and migrate_to_mssql.py
DB_SERVER=localhost,1433
DB_USERNAME=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_NAME=planventure
DB_DRIVER=ODBC Driver 17 for SQL Server

# JWT configuration
SECRET_KEY=your-secret-key-at-least-32-bytes-long
JWT_SECRET_KEY=your-jwt-secret-key-at-least-32-bytes-long

# Email configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@planventure.com

# Application configuration
FLASK_APP=app.py
FLASK_ENV=development
